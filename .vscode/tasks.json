{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "scons: build",
            "type": "shell",
            "command": "scons",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "scons: clean",
            "type": "shell",
            "command": "scons -c",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "run: RpGame",
            "type": "shell",
            "command": "./RpGame",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "scons: build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
